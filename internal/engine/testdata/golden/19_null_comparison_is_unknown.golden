-- query
SELECT id, country FROM customers WHERE country <> 'CA'

-- plan (unoptimized)
Project(id, country)
└─ Filter(country <> 'CA')
   └─ Scan(customers) reads 5 of 5 columns [id, name, country, plan, signup_date], 12 rows

-- plan (optimized)
Project(id, country)
└─ Filter(country <> 'CA')
   └─ Scan(customers) reads 2 of 5 columns [id, country], 12 rows

rules applied: projection pruning

