-- query
SELECT c.name, o.amount FROM customers c JOIN orders o ON c.id = o.customer_id ORDER BY o.id LIMIT 5

-- plan (unoptimized)
Limit(5)
└─ Project(c.name, o.amount)
   └─ Sort(o.id)
      └─ HashJoin(inner, on c.id = o.customer_id)
         ├─ probe: Scan(customers AS c) reads 5 of 5 columns [id, name, country, plan, signup_date], 12 rows
         └─ build: Scan(orders AS o) reads 6 of 6 columns [id, customer_id, sku, qty, amount, order_date], 30 rows

-- plan (optimized)
Limit(5)
└─ Project(c.name, o.amount)
   └─ Sort(o.id)
      └─ HashJoin(inner, on c.id = o.customer_id)
         ├─ probe: Scan(customers AS c) reads 2 of 5 columns [id, name], 12 rows
         └─ build: Scan(orders AS o) reads 3 of 6 columns [id, customer_id, amount], 30 rows

rules applied: projection pruning

-- result
name        | amount
------------+-------
Ada Okafor  |     29
Ada Okafor  |     64
Bruno Salas |  29.25
Chen Wei    |     44
Chen Wei    |     28
(5 rows)
