-- query
SELECT amount > 50 AS big, COUNT(*) AS n FROM orders GROUP BY amount > 50 ORDER BY big

-- plan (unoptimized)
Project("amount > 50" AS big, "COUNT(*)" AS n)
└─ Sort("amount > 50")
   └─ HashAggregate(group by amount > 50, COUNT(*))
      └─ Scan(orders) reads 6 of 6 columns [id, customer_id, sku, qty, amount, order_date], 30 rows

-- plan (optimized)
Project("amount > 50" AS big, "COUNT(*)" AS n)
└─ Sort("amount > 50")
   └─ HashAggregate(group by amount > 50, COUNT(*))
      └─ Scan(orders) reads 1 of 6 columns [amount], 30 rows

rules applied: projection pruning

-- result
big   | n
------+---
NULL  |  1
false | 22
true  |  7
(3 rows)
