-- query
SELECT category, COUNT(*) AS n FROM products GROUP BY category HAVING COUNT(*) > 1 ORDER BY category

-- plan (unoptimized)
Project(products.category, "COUNT(*)" AS n)
└─ Sort(products.category)
   └─ Filter("COUNT(*)" > 1)
      └─ HashAggregate(group by category, COUNT(*))
         └─ Scan(products) reads 4 of 4 columns [sku, title, category, unit_price], 8 rows

-- plan (optimized)
Project(products.category, "COUNT(*)" AS n)
└─ Sort(products.category)
   └─ Filter("COUNT(*)" > 1)
      └─ HashAggregate(group by category, COUNT(*))
         └─ Scan(products) reads 1 of 4 columns [category], 8 rows

rules applied: projection pruning

-- result
category   | n
-----------+--
bath       | 2
homeware   | 2
lighting   | 2
stationery | 2
(4 rows)
