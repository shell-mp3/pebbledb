-- query
SELECT COUNT(*) AS all_orders, COUNT(amount) AS priced FROM orders

-- plan (unoptimized)
Project("COUNT(*)" AS all_orders, "COUNT(amount)" AS priced)
└─ HashAggregate(no group by, COUNT(*), COUNT(amount))
   └─ Scan(orders) reads 6 of 6 columns [id, customer_id, sku, qty, amount, order_date], 30 rows

-- plan (optimized)
Project("COUNT(*)" AS all_orders, "COUNT(amount)" AS priced)
└─ HashAggregate(no group by, COUNT(*), COUNT(amount))
   └─ Scan(orders) reads 1 of 6 columns [amount], 30 rows

rules applied: projection pruning

-- result
all_orders | priced
-----------+-------
        30 |     29
(1 row)
