-- query
SELECT id, sku FROM orders LIMIT 5

-- plan (unoptimized)
Limit(5)
└─ Project(id, sku)
   └─ Scan(orders) reads 6 of 6 columns [id, customer_id, sku, qty, amount, order_date], 30 rows

-- plan (optimized)
Limit(5)
└─ Project(id, sku)
   └─ Scan(orders) reads 2 of 6 columns [id, sku], 30 rows

rules applied: projection pruning

-- result
id | sku
---+------
 1 | A-100
 2 | D-700
 3 | B-310
 4 | A-220
 5 | C-500
(5 rows)
