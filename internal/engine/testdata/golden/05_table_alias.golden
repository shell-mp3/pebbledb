-- query
SELECT p.sku, p.category FROM products AS p

-- plan (unoptimized)
Project(p.sku, p.category)
└─ Scan(products AS p) reads 4 of 4 columns [sku, title, category, unit_price], 8 rows

-- plan (optimized)
Project(p.sku, p.category)
└─ Scan(products AS p) reads 2 of 4 columns [sku, category], 8 rows

rules applied: projection pruning

